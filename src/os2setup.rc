DLGTEMPLATE IDD_CONFIG 
BEGIN
	DIALOG "GSview Install - Config", IDD_CONFIG, 12, 12, 215, 60, WS_VISIBLE, FCF_SYSMENU | FCF_TITLEBAR
	BEGIN
		DEFPUSHBUTTON "OK", DID_OK, 6, 4, 51, 14
		PUSHBUTTON "Don't update config.sys", DID_CANCEL, 60, 4, 121, 14
		CONTROL "Some changes will be made to your config.sys.\012Your old config.sys will be renamed config.gs.", IDD_CONFIG_TEXT, 8, 24, 198, 32, WC_STATIC, SS_TEXT | DT_LEFT | DT_TOP | DT_WORDBREAK | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
	END

END


STRINGTABLE
BEGIN
	IDS_DIRNOTEXIST AADIRNOTEXIST
	IDS_MKDIRFAIL AAMKDIRFAIL
	IDS_GSVIEWBASE GSVIEW_BASEDIR
	IDS_BETAWARN AABETAWARN
	IDS_INSTALLABORT AAINSTALLABORT
	IDS_SETUPOK AAINSTALLOKPM
	IDS_SKIPGSINSTALL AASKIPGSINSTALL
END
