DLGTEMPLATE IDD_FILE 
BEGIN
	DIALOG AAINSTALLMISSING1, IDD_FILE, 12, 12, 279, 61, WS_VISIBLE, FCF_SYSMENU | FCF_TITLEBAR
	BEGIN
		DEFPUSHBUTTON AAOK, DID_OK, 6, 4, 51, 14
		PUSHBUTTON AACANCEL, DID_CANCEL, 70, 4, 51, 14
