DLGTEMPLATE IDD_FILE 
BEGIN
	DIALOG "GSview Install - Missing ZIP file", IDD_FILE, 12, 12, 279, 61, WS_VISIBLE, FCF_SYSMENU | FCF_TITLEBAR
	BEGIN
