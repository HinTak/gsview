/* gvwin2.rc */
/* Resources for GSVWXX.DLL, which contains the language dependent */
/* resources for MS-Windows Ghostscript */

#ifndef GVWIN1
#include <windows.h>
#ifndef _Windows
#define _Windows
#endif
#include "gvcrc.h"
#endif

#ifndef DS_3DLOOK
#define DS_3DLOOK 0x0004L	/* for Windows 95 look */
#endif

#include "gvclang.h"
#include "gvclang.rc"
#include "gvwlang.rc"


#ifndef GVWIN1
ID_GSVIEW ICON "binary/gvwin1.ico"
#endif

