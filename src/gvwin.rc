 LTEXT "Author: Russell Lang  (rjl@aladdin.com)", -1, 8, 164, 240, 8
 ICON ID_GSVIEW, ABOUT_ICON, 8, 8, 18, 20
}

InputDlgBox DIALOG 48, 32, 192, 56
