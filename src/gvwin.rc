	LTEXT "", INFO_BBOX, 60, 40, 80, 8
	RTEXT "Orientation:", -1, 8, 48, 48, 8
	LTEXT "", INFO_ORIENT, 60, 48, 60, 8
	RTEXT "Default Media:", -1, 8, 64, 48, 8
	LTEXT "", INFO_DEFMEDIA, 60, 64, 60, 8
	RTEXT "Page Order:", -1, 8, 56, 48, 8
	LTEXT "", INFO_ORDER, 60, 56, 60, 8
