AboutDlgBox DIALOG 16, 16, 256, 180
STYLE DS_MODALFRAME | 0x4L | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About GSview for Windows"
FONT 8, "Helv"
{
 DEFPUSHBUTTON "&Ok", IDOK, 218, 5, 32, 14, BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP | WS_CHILD
 LTEXT "GSVIEW32.EXE", -1, 32, 8, 64, 8
 RTEXT "Version:", -1, 86, 8, 32, 8
 LTEXT GSVIEW_VERSION, -1, 120, 8, 38, 8
