/* winsetup.rc */
/* Resources for MS-Windows installation program */

#include "windows.h"
#include "setup.h"

#ifndef DS_3DLOOK
#define DS_3DLOOK 0x0004L	/* for Windows 95 look */
#endif


IDD_INTRO DIALOG PRELOAD FIXED 18, 18, 160, 92
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_3DLOOK
CAPTION "GSview Install - Introduction"
Font 8, "Helv"
BEGIN
	PUSHBUTTON "OK", IDOK, 8, 70, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 56, 70, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	LTEXT "Installation program for:\r    GSview 1.4\r    Aladdin Ghostscript 3.53", IDD_INTRO_T1, 8, 7, 123, 24, WS_CHILD | WS_VISIBLE | WS_GROUP
	LTEXT "Before continuing installation, make sure you have the 4 disks listed in README.GV.", IDD_INTRO_T2, 9, 43, 144, 16, WS_CHILD | WS_VISIBLE | WS_GROUP
END

IDD_COPYRIGHT DIALOG PRELOAD FIXED 18, 18, 202, 134
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_3DLOOK
CAPTION "GSview Install - Copyright"
Font 8, "Helv"
BEGIN
	PUSHBUTTON "OK", IDOK, 8, 112, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 56, 112, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	LTEXT "GSview and Aladdin Ghostscript are separate programs.  They are owned by separate entities.", IDD_COPYRIGHT_T1, 6, 6, 184, 18, WS_CHILD | WS_VISIBLE | WS_GROUP
	LTEXT "GSview:\r    Copyright (C) 1993-1995 Russell Lang.\r    All rights reserved.\r    See the file LICENCE for more details.", IDD_COPYRIGHT_T2, 8, 30, 184, 32, WS_CHILD | WS_VISIBLE | WS_GROUP
	LTEXT "Aladdin Ghostscript:\r    Copyright (C) 1994, 1995 Aladdin Enterprises,\r    Menlo Park, California, U.S.A.  All rights reserved.\r    See the file PUBLIC for more details.", IDD_COPYRIGHT_T3, 8, 70, 184, 32, WS_CHILD | WS_VISIBLE | WS_GROUP
END

IDD_DIR DIALOG PRELOAD FIXED 18, 18, 180, 100
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_3DLOOK
CAPTION "GSview Install - Directory"
Font 8, "Helv"
BEGIN
	LTEXT "The base directory for GSview and Ghostscript is shown below.\rWithin the base directory, GSview will be installed into the subdirectory 'gsview' and Ghostscript will be installed into the subdirectory 'gs3.53'.\rChange the base directory if you wish.", IDD_DIR_TEXT, 6, 6, 168, 48, WS_CHILD | WS_VISIBLE | WS_GROUP
	PUSHBUTTON "OK", IDOK, 9, 80, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 57, 80, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	EDITTEXT ID_ANSWER, 8, 60, 164, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
END


IDD_UNZIP DIALOG PRELOAD FIXED 18, 18, 86, 44
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE | DS_3DLOOK | WS_EX_TOPMOST
CAPTION "GSview Install"
Font 8, "Helv"
BEGIN
	LTEXT "Unzipping files", IDD_UNZIP_TEXT, 8, 8, 69, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
	PUSHBUTTON "Cancel", IDCANCEL, 8, 24, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
END

IDD_FILE DIALOG PRELOAD FIXED 18, 18, 179, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_3DLOOK
CAPTION "GSview Install - Missing ZIP file"
Font 8, "Helv"
BEGIN
	LTEXT "Can't find ZIP file.  Insert disk with the file below.", IDD_FILE_TEXT, 6, 6, 168, 10, WS_CHILD | WS_VISIBLE | WS_GROUP
	PUSHBUTTON "OK", IDOK, 8, 40, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 56, 40, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	EDITTEXT ID_ANSWER, 8, 19, 164, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
END

IDD_CONFIG DIALOG PRELOAD FIXED 18, 18, 189, 59
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_3DLOOK
CAPTION "GSview Install - Config"
Font 8, "Helv"
BEGIN
	PUSHBUTTON "OK", IDOK, 8, 40, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Don't update autoexec.bat", IDCANCEL, 56, 40, 100, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	LTEXT "The following line will be added to your autoexec.bat\r     SET TEMP=C:\\\rYour old autoexec.bat will be renamed autoexec.gs", IDD_CONFIG_TEXT, 8, 8, 173, 24, WS_CHILD | WS_VISIBLE | WS_GROUP
END


IDD_ATM DIALOG PRELOAD FIXED 18, 18, 175, 101
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_3DLOOK
CAPTION "GSview Install - Type 1 fonts"
FONT 8, "Helv"
BEGIN
 DEFPUSHBUTTON "Yes", IDOK, 9, 80, 32, 14
 PUSHBUTTON "No", IDCANCEL, 57, 80, 32, 14
 LTEXT "Your system appears to have some Type 1 fonts (as part of Adobe Type Manager) of better quality than those distributed with Ghostscript.", -1, 6, 6, 152, 24
 LTEXT "Before using these fonts with Ghostscript, you MUST check if your font licence allows you to do so.", -1, 6, 34, 164, 16
 LTEXT "Do you want to configure Ghostscript to use these Type 1 fonts?", -1, 6, 54, 164, 16
END

