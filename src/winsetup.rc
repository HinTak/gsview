/* winsetup.rc */
/* Resources for MS-Windows installation program */

#include "windows.h"
#include "gvcver.h"
#include "setup.h"

#ifndef DS_3DLOOK
#define DS_3DLOOK 0x0004L	/* for Windows 95 look */
#endif

ID_GSVIEW ICON "binary/gvwin1.ico"

ID_GHOSTSCRIPT ICON "binary/gstext.ico"


IDD_INTRO DIALOG PRELOAD FIXED DISCARDABLE 18, 18, 168, 92
STYLE DS_MODALFRAME | 0x4L | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GSview Install - Introduction"
FONT 8, "Helv"
{
 PUSHBUTTON "OK", IDOK, 8, 70, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
 PUSHBUTTON "Cancel", IDCANCEL, 56, 70, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
 LTEXT "Installation program for:", IDD_INTRO_T1, 8, 6, 152, 8
 LTEXT "Before continuing installation, make sure you have the 3 disks listed in README.TXT.", IDD_INTRO_T2, 8, 42, 152, 16
 LTEXT GSVIEW_PRODUCT, -1, 16, 16, 32, 8
 LTEXT GS_PRODUCT, -1, 16, 26, 72, 8
 LTEXT GSVIEW_VERSION, -1, 48, 16, 60, 8
 LTEXT GS_VERSION, -1, 88, 26, 60, 8
}

IDD_COPYRIGHT DIALOG PRELOAD FIXED DISCARDABLE 18, 18, 228, 134
STYLE DS_MODALFRAME | 0x4L | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GSview Install - Copyright"
FONT 8, "Helv"
{
 PUSHBUTTON "OK", IDOK, 8, 112, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
 PUSHBUTTON "Cancel", IDCANCEL, 56, 112, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
 LTEXT "GSview and Aladdin Ghostscript are separate programs.  They are owned by separate entities.", IDD_COPYRIGHT_T1, 6, 6, 184, 18, WS_CHILD | WS_VISIBLE | WS_GROUP
 ICON ID_GSVIEW, ID_GSVIEW, 8, 32, 18, 20
 LTEXT "GSview:", IDD_COPYRIGHT_T2, 40, 30, 176, 8
 LTEXT GSVIEW_COPYRIGHT1, -1, 48, 40, 160, 8
 LTEXT GSVIEW_COPYRIGHT2, -1, 48, 48, 160, 8
 LTEXT GSVIEW_COPYRIGHT3, -1, 48, 56, 160, 8
 ICON ID_GHOSTSCRIPT, ID_GHOSTSCRIPT, 8, 72, 18, 20
 LTEXT "Aladdin Ghostscript:", IDD_COPYRIGHT_T3, 40, 70, 176, 8
 LTEXT GS_COPYRIGHT1, -1, 48, 80, 160, 8
 LTEXT GS_COPYRIGHT2, -1, 48, 88, 174, 8
 LTEXT GS_COPYRIGHT3, -1, 48, 96, 160, 8
}

IDD_DIR DIALOG PRELOAD FIXED DISCARDABLE 18, 20, 219, 122
STYLE DS_MODALFRAME | 0x4L | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GSview Install - Directory"
FONT 8, "Helv"
{
 PUSHBUTTON "OK", IDOK, 7, 102, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
 PUSHBUTTON "Cancel", IDCANCEL, 55, 102, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
 LTEXT "The base directory for GSview and Ghostscript is:", IDD_DIR_TEXT, 6, 6, 206, 8
 EDITTEXT ID_ANSWER, 6, 18, 197, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
 LTEXT "Within the base directory, GSview will be installed into the subdirectory:", -1, 6, 34, 206, 16
 LTEXT GSVIEW_BASEDIR, -1, 16, 53, 60, 8
 LTEXT "Ghostscript will be installed into the subdirectory:", IDC_LTEXT2, 6, 65, 206, 8
 LTEXT GS_BASEDIR, -1, 16, 75, 60, 8
 LTEXT "Change the base directory if you wish.", IDC_LTEXT1, 6, 89, 206, 8
}

IDD_MKDIR DIALOG 7, 18, 149, 71
STYLE DS_MODALFRAME | 0x4L | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "GSview Install - Make Directory"
FONT 8, "Helv"
{
 DEFPUSHBUTTON "Yes", IDYES, 12, 52, 32, 14
 PUSHBUTTON "Cancel", IDCANCEL, 72, 52, 32, 14
 LTEXT "The directory", -1, 8, 8, 97, 8
 LTEXT "XXXX", IDD_MKDIR_TEXT, 20, 20, 60, 8
 LTEXT "does not exist.  Create it?", -1, 8, 32, 133, 8
}

IDD_FILE DIALOG PRELOAD FIXED 18, 18, 179, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_3DLOOK
CAPTION "GSview Install - Missing ZIP file"
Font 8, "Helv"
BEGIN
	LTEXT "Can't find ZIP file.  Insert disk with the file below.", IDD_FILE_TEXT, 6, 6, 168, 10, WS_CHILD | WS_VISIBLE | WS_GROUP
	PUSHBUTTON "OK", IDOK, 8, 40, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 56, 40, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	EDITTEXT ID_ANSWER, 8, 19, 164, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
END

IDD_CONFIG DIALOG PRELOAD FIXED 18, 18, 189, 59
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_3DLOOK
CAPTION "GSview Install - Config"
Font 8, "Helv"
BEGIN
	PUSHBUTTON "OK", IDOK, 8, 40, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Don't update autoexec.bat", IDCANCEL, 56, 40, 100, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	LTEXT "The following line will be added to your autoexec.bat\r     SET TEMP=C:\\\rYour old autoexec.bat will be renamed autoexec.gs", IDD_CONFIG_TEXT, 8, 8, 173, 24, WS_CHILD | WS_VISIBLE | WS_GROUP
END


IDD_ATM DIALOG PRELOAD FIXED DISCARDABLE 18, 18, 192, 101
STYLE DS_MODALFRAME | 0x4L | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "GSview Install - Type 1 fonts"
FONT 8, "Helv"
{
 DEFPUSHBUTTON "Yes", IDOK, 9, 80, 32, 14
 PUSHBUTTON "No", IDCANCEL, 57, 80, 32, 14
 LTEXT "Your system appears to have some Type 1 fonts (as part of Adobe Type Manager) of better quality than those distributed with Ghostscript.", -1, 6, 6, 180, 24
 LTEXT "Before using these fonts with Ghostscript, you MUST check if your font licence allows you to do so.", -1, 6, 34, 180, 16
 LTEXT "Do you want to configure Ghostscript to use these Type 1 fonts?", -1, 6, 54, 180, 16
}

IDD_TEXTWIN DIALOG 6, 15, 308, 194
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_3DLOOK
CAPTION "GSview Install - Unzipping"
Font 8, "Helv"
{
 DEFPUSHBUTTON "Cancel", IDCANCEL, 8, 174, 50, 14
 PUSHBUTTON "Copy", TEXTWIN_COPY, 126, 174, 50, 14
 EDITTEXT TEXTWIN_MLE, 8, 8, 290, 160, ES_MULTILINE | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
}


