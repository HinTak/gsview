# makefile.msc - for Microsoft Visual C++ 5.0
# EPSTOOL

CFLAGS=-D__WIN32__ -DEPSTOOL -I..\src -I.
CC=cl

OBJS=epstool.obj gvceps.obj ps.obj

all: epstool.exe

.c.obj:
	$(CC) $(CFLAGS) -c $*.c

epstool.obj: epstool.c epstool.h ../src/ps.h ../src/gvceps.c

ps.obj: ../src/ps.c epstool.h ../src/ps.h ../src/gvceps.c
	$(CC) -c $(CFLAGS) ../src/ps.c

gvceps.obj: ../src/gvceps.c epstool.h ../src/ps.h
	$(CC) -c $(CFLAGS) ../src/gvceps.c

epstool.exe: $(OBJS)
	$(CC) $(CFLAGS) $(INCLUDES) /Foepstool.exe $(OBJS)

veryclean: clean
	-del epstool.exe
	-del epstool2.exe

clean:
	-del epstool.map
	-del epstool.obj
	-del ps.obj
	-del gvceps.obj


zip: all
	copy epstool.htm ..\epstool.htm
	copy epstool.exe ..\epstool.exe
	cd ..
	rename epstool2.exe epstool2.exe
	-del epstool.zip
	zip -@ epstool < epstool\files.txt
	cd epstool

tar:	zip
	unzip -o ..\epstool
	copy src\* epstool
	-del ..\epstool.tar
	cd epstool
	flip -u *.*
	cd ..
	tar -cvf ../epstool.tar epstool

