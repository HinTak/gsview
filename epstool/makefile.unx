# makefile.unx
# EPSTOOL

RM=/bin/rm -f
SHELL=/bin/sh

BINDIR=/usr/local/bin
INCLUDES=-I/usr/openwin/include
LIBS=
# if you have a strict ANSI compiler, add -D__STDC__
DEFINES=-DUNIX -DEPSTOOL -DHAVE_UNISTD_H
OBJ=o
CC=gcc

OBJS=epstool.$(OBJ) gvceps.$(OBJ) gvcdsc.$(OBJ) gvcfile.$(OBJ)

all: epstool

.cpp.$(OBJ):
	$(CC) $(CFLAGS) $(INCLUDES) $(DEFINES) -c $*.cpp


epstool.$(OBJ): epstool.cpp epstool.h gvcdsc.h gvceps.h gvcfile.h

gvcdsc.$(OBJ): gvcdsc.cpp epstool.h gvcdsc.h gvceps.h gvcfile.h

gvceps.$(OBJ): gvceps.cpp epstool.h gvcdsc.h gvceps.h gvcfile.h

gvcfile.$(OBJ): gvcfile.cpp gvcfile.h

epstool: $(OBJS)
	$(CC) $(CFLAGS) $(INCLUDES) -o epstool $(OBJS) $(LIBS) 

clean:
	-$(RM) epstool.$(OBJ)
	-$(RM) gvceps.$(OBJ)
	-$(RM) gvcdsc.$(OBJ)
	-$(RM) gvcfile.$(OBJ)

veryclean: clean
	-$(RM) epstool

install: epstool
	cp epstool $(BINDIR)
	chmod 755 $(BINDIR)/epstool
